rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Who is asking. Access comes from the People list (the `users` collection,
    // one document per person, keyed by their sign-in email). The ADMIN_EMAIL
    // below is always an administrator so the board can never lock itself out.
    function email() {
      return request.auth != null ? request.auth.token.email.lower() : '';
    }
    function hasProfile() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(email()));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(email())).data;
    }
    function isAdmin() {
      return request.auth != null
          && (email() == 'joejr@yaboofence.com' || (hasProfile() && me().role == 'admin'));
    }
    function isOffice() {
      return isAdmin() || (hasProfile() && me().role == 'office');
    }
    function isCrew() {
      return hasProfile() && me().role == 'crew';
    }
    // Office and admin see every shop; everyone else sees only the shops on their entry.
    function seesShop(shop) {
      return isOffice() || (hasProfile() && (me().all == true || shop in me().shops));
    }
    // A crew update may only touch the progress fields on a job.
    function progressOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['done', 'log', 'updatedAt', 'updatedBy']);
    }

    match /users/{person} {
      allow read: if isAdmin() || (request.auth != null && person == email());
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if hasProfile() || isAdmin();
      allow write: if isOffice();
    }
    match /crews/{id} {
      allow read: if seesShop(resource.data.shop);
      allow write: if isOffice();
    }
    match /equipment/{id} {
      allow read: if seesShop(resource.data.shop);
      allow write: if isOffice();
    }
    match /yard/{id} {
      allow read: if seesShop('yard');
      allow write: if isOffice();
    }
    match /jobs/{id} {
      allow read: if seesShop(resource.data.shop);
      allow create, delete: if isOffice();
      allow update: if isOffice() || (isCrew() && seesShop(resource.data.shop) && progressOnly());
    }
    match /files/{id} {
      allow read: if seesShop(resource.data.shop);
      allow write: if isOffice();
      match /chunks/{n} {
        allow read: if seesShop(get(/databases/$(database)/documents/files/$(id)).data.shop);
        allow write: if isOffice();
      }
    }
  }
}
